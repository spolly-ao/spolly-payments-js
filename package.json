{
  "name": "@spolly-ao/spolly-payments",
  "version": "0.1.0",
  "description": "O SDK em JavaScript do Spolly Payments: o cliente da API (sessões de checkout, estornos, conta) e a verificação da assinatura dos webhooks.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./webhook": {
      "types": "./src/webhook.d.ts",
      "default": "./src/webhook.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100"
  },
  "types": "./src/index.d.ts"
}
